# ======================================================================
# Copy this file to `.env` and fill in the values.
# In production (Railway) the .env file is NOT used: variables are set
# in the Railway dashboard → service → Variables.
# ======================================================================

# --- Database (Supabase / PostgreSQL) ---
# DATABASE_URL = POOLED connection (port 6543, for the running app)
# DIRECT_URL   = DIRECT connection (port 5432, for prisma db push / migrate)
# Found on Supabase: Project → Connect → ORMs → Prisma
DATABASE_URL="postgresql://postgres.xxxx:PASSWORD@aws-0-eu-central-1.pooler.supabase.com:6543/postgres?pgbouncer=true"
DIRECT_URL="postgresql://postgres.xxxx:PASSWORD@aws-0-eu-central-1.pooler.supabase.com:5432/postgres"

# --- Auth ---
# Generate a strong secret: openssl rand -base64 32
JWT_SECRET=""
JWT_EXPIRES="7d"

# --- Stripe (UAE) — TEST keys only for now (sk_test_... / whsec_...) ---
# Stripe Dashboard → Developers → API keys
STRIPE_SECRET_KEY="sk_test_..."
# Stripe Dashboard → Developers → Webhooks → endpoint → Signing secret
# Locally: `stripe listen --forward-to localhost:3000/api/payments/webhook`
STRIPE_WEBHOOK_SECRET="whsec_..."

# --- Email (account verification + password reset) ---
# Priority: 1) Brevo API (BREVO_API_KEY) — recommended. 2) generic SMTP
# (SendGrid, Mailgun, SES...). If both are empty: codes are logged to the
# console (development only).
# Key: Brevo → SMTP & API → API Keys
BREVO_API_KEY=""
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASS=""
MAIL_FROM="Artisan <no-reply@yourdomain.com>"

# --- Development ---
# Fixed OTP code accepted ONLY when NODE_ENV != production (demo app: 123456)
OTP_DEV_CODE="123456"
# CORS: in production, set the app's origin (e.g. https://app.yourdomain.com)
CORS_ORIGIN=""

# --- REAL PROVIDER (phase 2): GCC Open Banking (Lean Technologies) ---
BANK_PROVIDER="mock"           # mock | lean
LEAN_APP_TOKEN=""
LEAN_APP_SECRET=""

# --- AI (Gemini) — request/quote analysis + EN/AR translation ---
# If empty: a deterministic mock provider is used (no external calls).
# Free key at https://aistudio.google.com/apikey
GEMINI_API_KEY=""
GEMINI_MODEL="gemini-flash-latest"

# --- Admin (used ONLY by `npm run prisma:seed-admin`, never by a public endpoint) ---
ADMIN_EMAIL=""
ADMIN_PASSWORD=""
