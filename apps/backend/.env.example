# ======================================================================
# Copia questo file in `.env` e compila i valori.
# In produzione (Railway) NON si usa il file .env: le variabili si
# impostano nel dashboard Railway → servizio → Variables.
# ======================================================================

# --- Database (Supabase / PostgreSQL) ---
# DATABASE_URL = connessione POOLED (porta 6543, per l'app in esecuzione)
# DIRECT_URL   = connessione DIRETTA (porta 5432, per prisma db push / migrate)
# Si trovano su Supabase: Project → Connect → ORMs → Prisma
DATABASE_URL="postgresql://postgres.xxxx:PASSWORD@aws-0-eu-central-1.pooler.supabase.com:6543/postgres?pgbouncer=true"
DIRECT_URL="postgresql://postgres.xxxx:PASSWORD@aws-0-eu-central-1.pooler.supabase.com:5432/postgres"

# --- Auth ---
# Genera un segreto forte: openssl rand -base64 32
JWT_SECRET=""
JWT_EXPIRES="7d"

# --- Stripe (UAE) — per ora SOLO chiavi di TEST (sk_test_... / whsec_...) ---
# Dashboard Stripe → Developers → API keys
STRIPE_SECRET_KEY="sk_test_..."
# Dashboard Stripe → Developers → Webhooks → endpoint → Signing secret
# In locale: `stripe listen --forward-to localhost:3000/api/payments/webhook`
STRIPE_WEBHOOK_SECRET="whsec_..."

# --- Email (verifica account + reset password) via SMTP ---
# Funziona con Resend, SendGrid, Mailgun, SES... Se vuoto: i codici vengono
# loggati in console (solo sviluppo).
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASS=""
MAIL_FROM="Artisan <no-reply@tuodominio.com>"

# --- Sviluppo ---
# Codice OTP fisso accettato SOLO con NODE_ENV != production (demo app: 123456)
OTP_DEV_CODE="123456"
# CORS: in produzione impostare l'origine dell'app (es. https://app.tuodominio.com)
CORS_ORIGIN=""

# --- PROVIDER REALE (fase 2): Open Banking GCC (Lean Technologies) ---
BANK_PROVIDER="mock"           # mock | lean
LEAN_APP_TOKEN=""
LEAN_APP_SECRET=""
